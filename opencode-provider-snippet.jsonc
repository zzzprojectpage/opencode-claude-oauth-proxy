// Merge this block into your global OpenCode configuration:
//   ~/.config/opencode/opencode.jsonc
//   Windows: C:\Users\<you>\.config\opencode\opencode.jsonc
//
// The `/v1` suffix is required: OpenCode requests <baseURL>/messages?beta=true,
// and the proxy serves that route as /v1/messages.
//
// After saving, run /connect in OpenCode, choose "Anthropic" →
// "Manually enter API Key", and paste the proxy key from config.yaml.

{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "anthropic": {
      "settings": {
        "baseURL": "http://127.0.0.1:8317/v1"
      }
    }
  }
}
